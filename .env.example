# ============================================
# API Configuration
# ============================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=deepseek/deepseek-v3.1-terminus
API_TIMEOUT=30000
MAX_TOKENS=500
TEMPERATURE=0.7
TOP_P=0.9
HTTP_REFERER=http://localhost:8000

# App Info
APP_TITLE=Verveo Todo Generator API (Node)
APP_VERSION=2.1.0
APP_DESCRIPTION=API thông minh để tạo todo từ prompt sử dụng DeepSeek AI
HOST=0.0.0.0
PORT=8000

# ============================================
# Database Configuration
# ============================================
DB_USER=verveo_user
DB_PASS=verveo_password_2024
DB_NAME=verveo_db

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your_jwt_secret_here_at_least_32_characters_long

# ============================================
# Email Service (Brevo)
# ============================================
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=noreply@verveo.click
BREVO_FROM_NAME=Verveo
TEST_EMAIL=your_test_email@gmail.com

# ============================================
# URLs
# ============================================
APP_URL=https://verify-account.verveo.click
FRONTEND_URL=https://api.verveo.click

# ============================================
# Google OAuth
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id_here

# ============================================
# Firebase Cloud Messaging (FCM) - v2.1.0
# ============================================

# Firebase Admin SDK (Required)
# Get from: Firebase Console > Project Settings > Service Accounts > Generate Private Key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Redis Configuration (Required for Queue & Distributed Lock)
REDIS_HOST=localhost
REDIS_PORT=6379

# Cron Jobs (Required)
ENABLE_CRON=true

# ============================================
# FCM Optional Settings
# ============================================

# Notification Logs (enable for debugging)
ENABLE_NOTIFICATION_LOGS=false

# Notification Retry Settings
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY=2000

# Startup Catch-up Settings
NOTIFICATION_CATCHUP_WINDOW_HOURS=2
NOTIFICATION_CATCHUP_LIMIT=500

# Queue Concurrency
QUEUE_CONCURRENCY=10
CATCHUP_CONCURRENCY=5
